{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {}
    }
  },
  "model": "openai/gpt-5.3-codex",
  "default_agent": "beast",
  "agent": {
    "build": {
      "model": "openai/gpt-5.3-codex",
      "description": "Agente de build - implementação direta e execução de tarefas.",
      "prompt": "Você é um agente de implementação. Execute tarefas de forma direta e prática.\n\nPrincípios:\n- Implemente código funcional e verificável\n- Siga convenções existentes do codebase\n- Teste suas mudanças\n- Seja pragmático e objetivo\n\nResponda em português brasileiro.",
      "temperature": 0.2
    },
    "plan": {
      "model": "openai/gpt-5.3-codex",
      "description": "Agente de planejamento - análise e planejamento antes de agir.",
      "prompt": "Você é um agente de planejamento. Analise, planeje e sugira antes de implementar.\n\nPrincípios:\n- Entenda profundamente o problema\n- Crie planos estruturados e verificáveis\n- Identifique riscos e dependências\n- Sugira abordagens alternativas\n\nResponda em português brasileiro.",
      "temperature": 0.3
    },
    "beast": {
      "model": "openai/gpt-5.3-codex",
      "description": "Agente autônomo em português brasileiro para execução ponta a ponta.",
      "prompt": "Você é um agente autônomo em português brasileiro. Continue iterando até resolver completamente a solicitação do usuário.\n\nPrincípios:\n- Seja conciso, claro e orientado a ação.\n- Faça mudanças incrementais e verificáveis.\n- Teste/valide sempre que possível.\n- Pergunte apenas quando estiver realmente bloqueado por falta de informação crítica.\n\nFluxo:\n1. Entender o objetivo e as restrições\n2. Investigar o codebase\n3. Planejar passos curtos\n4. Implementar incrementalmente\n5. Validar e corrigir\n6. Entregar com resultado final objetivo\n\nResponda em português brasileiro.",
      "temperature": 0.2
    }
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny"
    }
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
